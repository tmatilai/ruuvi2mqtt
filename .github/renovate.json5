{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Keep GitHub Actions pinned to commit SHAs (with the version comment).
    'helpers:pinGitHubActionDigests',
  ],

  // Fridays and Saturdays only, with a cooldown for fresh releases.
  // A tighter window didn't leave Renovate enough runs to open its PRs.
  timezone: 'Europe/Helsinki',
  schedule: ['* * * * 5,6'],
  // Keep in sync with global-min-publish-age in .cargo/config.toml.
  minimumReleaseAge: '3 days',

  // Refresh transitive deps in both Cargo.lock files.
  lockFileMaintenance: {
    enabled: true,
    // Don't rebuild the PR while it waits out minimumReleaseAge. A rebuild
    // can pull in fresh releases and restart the wait.
    rebaseWhen: 'conflicted',
  },

  packageRules: [
    {
      // Pin exact versions in Cargo.toml. With ranges, Renovate runs a plain
      // `cargo update` after editing Cargo.toml, which resolves to the newest
      // release even when that is still within minimumReleaseAge, and then
      // refuses the result. See renovatebot/renovate#41624.
      matchManagers: ['cargo'],
      rangeStrategy: 'pin',
    },
    {
      matchManagers: ['cargo'],
      matchFileNames: ['Cargo.toml'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'Linux crates (minor and patch)',
    },
    {
      matchManagers: ['cargo'],
      matchFileNames: ['ruuvi2mqtt-esp32/Cargo.toml'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'ESP32 crates (minor and patch)',
    },
    {
      // Major updates may break. Label them for the Claude review in CI.
      matchUpdateTypes: ['major'],
      addLabels: ['breaking-risk'],
    },
    {
      // 0.x minor bumps may break too, so treat them like majors:
      // separate PRs instead of the groups above, and the review label.
      matchManagers: ['cargo'],
      matchCurrentVersion: '/^0\\./',
      matchUpdateTypes: ['minor'],
      groupName: null,
      addLabels: ['breaking-risk'],
    },
    {
      // The ESP-IDF crates and ESP-IDF itself often only build together.
      // esp32-nimble depends on a single esp-idf-svc minor, and new ESP-IDF
      // releases change the C API that esp-idf-hal and esp32-nimble bind to.
      // Keep them in one PR, overriding the split above. Still labeled for
      // the review.
      matchDepNames: ['/^esp-idf-/', '/^esp32-/', 'embuild', 'espressif/esp-idf'],
      groupName: 'ESP-IDF',
      addLabels: ['breaking-risk'],
    },
    {
      // A new ESP-IDF major needs matching esp-idf-sys/esp-idf-svc support.
      // Show it on the dependency dashboard instead of opening a PR.
      matchDepNames: ['espressif/esp-idf'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
  ],

  customManagers: [
    {
      // ESP_IDF_VERSION = "v5.5.5" in ruuvi2mqtt-esp32/.cargo/config.toml
      customType: 'regex',
      managerFilePatterns: ['/^ruuvi2mqtt-esp32/\\.cargo/config\\.toml$/'],
      matchStrings: ['ESP_IDF_VERSION\\s*=\\s*"(?<currentValue>v\\d+\\.\\d+\\.\\d+)"'],
      depNameTemplate: 'espressif/esp-idf',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver-coerced',
    },
    {
      // `cargo install [flags] <crate>@<version>` in workflows
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.ya?ml$/'],
      matchStrings: ['cargo install(?:\\s+--?[\\w-]+)*\\s+(?<depName>[\\w-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)'],
      datasourceTemplate: 'crate',
    },
    {
      // `# renovate: datasource=... depName=...` above a `FOO_VERSION := x.y.z` line in Makefiles
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Makefile$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+_VERSION\\s*:?=\\s*(?<currentValue>\\S+)',
      ],
    },
  ],
}
