# Bluetooth — NimBLE stack (required by esp32-nimble)
CONFIG_BT_ENABLED=y
# Dual-mode controller BLE-only. Only the ESP32 has Bluetooth Classic; the
# other chips ignore it.
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_ENABLED=y

# Wi-Fi
CONFIG_ESP_WIFI_ENABLED=y

# Increase stack size for the main task (Wi-Fi + MQTT)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Task watchdog — reboots when the idle task is starved for >15s, i.e. a busy
# loop in a higher-priority task. It does not catch a task blocked on an
# event; main.rs has a cycle timeout for that. Without PANIC, it only logs.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_PANIC=y

# Log level for the ESP-IDF C layer (Wi-Fi, BLE, MQTT internals).
# Rust log level is controlled separately via the LOG_LEVEL env var.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# For verbose C-layer debug output during development:
# CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
