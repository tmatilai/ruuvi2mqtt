# Bluetooth — NimBLE stack (required by esp32-nimble)
CONFIG_BT_ENABLED=y
# Dual-mode controller BLE-only. Only the ESP32 has Bluetooth Classic; the
# other chips ignore it.
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_ENABLED=y

# Wi-Fi
CONFIG_ESP_WIFI_ENABLED=y

# Increase stack size for the main task (Wi-Fi + MQTT)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Task watchdog — reboots when the idle task is starved for >15s, i.e. a busy
# loop in a higher-priority task. It does not catch a task blocked on an
# event; main.rs has a cycle timeout for that. Without PANIC, it only logs.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_PANIC=y

# Log level for the ESP-IDF C layer (Wi-Fi, BLE, MQTT internals).
# Rust log level is controlled separately via the LOG_LEVEL env var.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# For verbose C-layer debug output during development:
# CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y

# A smaller image leaves room for two app slots in a 4 MB flash. The board
# joins a Personal or open Wi-Fi network as a station, and is a TLS client
# only.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_LWIP_DHCPS=n
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_MBEDTLS_SSL_CACHE_C=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA=n
CONFIG_MBEDTLS_X509_CRL_PARSE_C=n
CONFIG_MBEDTLS_X509_CSR_PARSE_C=n
CONFIG_MBEDTLS_PEM_WRITE_C=n
CONFIG_MBEDTLS_PKCS7_C=n
CONFIG_MBEDTLS_SSL_ALL_ALERT_MESSAGES=n
# Brokers use P-256, P-384 or X25519.
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
# No WPA3 OWE ("enhanced open") networks.
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
# See MQTT_CA_FILE in README.md.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
