mqtt:
  server: "homeassistant.local"
  # Default: 1883, or 8883 with TLS.
  #port: 1883
  # Connects with TLS (default: false). Without ca_file, the OS certificate
  # store verifies the broker.
  #tls: true
  # A PEM CA certificate bundle, for a self-signed certificate or a private CA.
  #ca_file: /path/to/ca-bundle.pem
  # Skips the whole certificate verification (default: false). For testing only.
  #tls_insecure: false
  # MQTT_USER and MQTT_PASSWORD override these two, and an empty variable is an
  # error. Leave a setting out here to supply it only through the environment.
  user: "ruuvi2mqtt"
  password: "changeme"
  #client_id: "ruuvi2mqtt_<hostname>"
  #base_topic: "ruuvi2mqtt"
  # The shortest time between a tag's readings, in seconds, over all the
  # instances (default: 60). Use the same value on every instance. For ESP32
  # boards, see README.md.
  #throttle: 60

devices:
  AA:12:BB:34:CC:56:
    name: Ruuvi Indoors
    # The Home Assistant entities: tag (the default, a RuuviTag) or air (a Ruuvi
    # Air).
    #model: tag
  AB:CD:EF:98:76:54:
    name: Ruuvi Outdoors
